{
  "name": "eventos",
  "version": "0.1.0",
  "private": true,
  "description": "EventOS — Sistema Operativo para Eventos (Remo&Rent)",
  "workspaces": [
    "apps/*"
  ],
  "scripts": {
    "dev": "npm run dev --workspaces --if-present",
    "dev:api": "npm run start:dev -w apps/api",
    "dev:web": "npm run dev -w apps/web",
    "dev:landing": "npm run dev:clean -w apps/landing",
    "build": "npm run build --workspaces --if-present",
    "db:up": "docker compose up -d",
    "db:down": "docker compose down",
    "db:migrate": "npm run prisma:migrate -w apps/api",
    "db:deploy": "npm run prisma:deploy -w apps/api",
    "db:seed": "npm run prisma:seed -w apps/api",
    "db:seed:prod": "npm run prisma:seed:prod -w apps/api",
    "db:clean-demo": "npm run prisma:clean-demo -w apps/api",
    "db:studio": "npm run prisma:studio -w apps/api"
  }
}
