generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

enum RolUsuario {
  ADMIN
  COMERCIAL
  OPERATIVO
  COMPRAS
  FINANZAS
  ADMIN_PROVEEDOR
  OPERADOR_PROVEEDOR
}

enum EstadoOrdenCobro {
  BORRADOR
  PENDIENTE
  PAGADO
  VENCIDO
  CANCELADO
}

enum EstadoEventoProveedor {
  COTIZACION
  CONFIRMADO
  EN_EJECUCION
  COMPLETADO
  CANCELADO
}

enum TipoSeguimientoCliente {
  LLAMADA
  REUNION
  WHATSAPP
  CORREO
  VISITA
  NOTA
  RECORDATORIO
}

enum EstadoSeguimientoCliente {
  PENDIENTE
  COMPLETADO
  CANCELADO
}

enum PasarelaPagoProveedor {
  MERCADO_PAGO
}

enum EstadoEvento {
  BORRADOR
  COTIZACION
  CONFIRMADO
  EN_LOGISTICA
  EN_EJECUCION
  COMPLETADO
  CANCELADO
}

enum TipoProveedor {
  PROPIO
  SUBARRENDO
}

enum EstadoVerificacionProveedor {
  BORRADOR
  EN_REVISION
  VERIFICADO
}

enum OrigenCapturaProveedor {
  INTERNO
  TELEFONO
  VISITA
  WEB
}

enum UnidadMedidaProducto {
  PIEZA
  METRO
  METRO2
  PAQUETE
  SERVICIO
}

enum EstadoCotizacion {
  BORRADOR
  ENVIADA
  APROBADA
  RECHAZADA
}

enum TipoServicioContrato {
  GENERAL
  RENTA_MOBILIARIO
  SERVICIO
  BANQUETE
}

enum ModoPlantillaContrato {
  EDITOR
  ARCHIVO
}

enum EstadoPlantillaContrato {
  BORRADOR
  ACTIVA
  ARCHIVADA
}

enum TipoActividad {
  MONTAJE
  EVENTO
  DESMONTAJE
  ENTREGA
  RECOLECCION
}

enum EstadoLogistica {
  PENDIENTE
  PROGRAMADA
  EN_RUTA
  COMPLETADA
}

enum EstadoSubarrendo {
  IDENTIFICADO
  SOLICITADO
  CONFIRMADO
  RECIBIDO
  DEVUELTO
}

enum TipoMovimientoFinanciero {
  ANTICIPO
  PAGO
  REEMBOLSO
  GASTO
}

enum MetodoPago {
  EFECTIVO
  TRANSFERENCIA
  TARJETA
  CHEQUE
  OTRO
}

enum EstadoSuscripcion {
  PRUEBA
  ACTIVA
  SUSPENDIDA
  CANCELADA
  VENCIDA
}

enum EstadoPagoSuscripcion {
  PENDIENTE
  PAGADO
  FALLIDO
  REEMBOLSADO
}

enum EstadoMovimientoFinanciero {
  PENDIENTE
  CONFIRMADO
  CANCELADO
}

enum TipoDocumento {
  COTIZACION
  CONTRATO
  RECIBO
  ACTA_ENTREGA
  OTRO
}

model Usuario {
  id           String   @id @default(cuid())
  email        String   @unique
  passwordHash String
  nombre       String
  rol          RolUsuario
  proveedorId  String?
  activo       Boolean  @default(true)
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt

  proveedor      Proveedor? @relation(fields: [proveedorId], references: [id], onDelete: SetNull)
  eventosCreados Evento[]   @relation("EventoCreador")

  @@index([proveedorId])
}

model Cliente {
  id        String   @id @default(cuid())
  nombre    String
  empresa   String?
  email     String?
  telefono  String?
  direccion String?
  notas     String?
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  eventos Evento[]
}

model Evento {
  id              String       @id @default(cuid())
  titulo          String
  descripcion     String?
  fechaEvento     DateTime
  fechaMontaje    DateTime?
  fechaDesmontaje DateTime?
  lugar           String?
  estado          EstadoEvento @default(BORRADOR)
  notas           String?
  clienteId       String
  creadoPorId     String
  createdAt       DateTime     @default(now())
  updatedAt       DateTime     @updatedAt

  cliente      Cliente           @relation(fields: [clienteId], references: [id], onDelete: Restrict)
  creadoPor    Usuario           @relation("EventoCreador", fields: [creadoPorId], references: [id], onDelete: Restrict)
  cotizaciones Cotizacion[]
  actividades  ActividadAgenda[]
  logistica    Logistica?
  subarrendos  Subarrendo[]
  movimientos  MovimientoFinanciero[]
  documentos   Documento[]

  @@index([clienteId])
  @@index([estado])
  @@index([fechaEvento])
}

model Producto {
  id            String   @id @default(cuid())
  codigo        String   @unique
  nombre        String
  categoria     String?
  descripcion   String?
  cantidadTotal Int      @default(0)
  costoUnitario Decimal  @default(0) @db.Decimal(12, 2)
  precioRenta   Decimal  @default(0) @db.Decimal(12, 2)
  activo        Boolean  @default(true)
  createdAt     DateTime @default(now())
  updatedAt     DateTime @updatedAt

  items CotizacionItem[]

  @@index([categoria])
  @@index([activo])
}

model Proveedor {
  id                   String                      @id @default(cuid())
  nombre               String
  razonSocial          String?
  rfc                  String?
  contacto             String?
  email                String?
  telefono             String?
  sitioWeb             String?
  direccion            String?
  ciudad               String?
  entidadFederativa    String?
  alcaldia             String?
  latitud              Decimal?                    @db.Decimal(10, 7)
  longitud             Decimal?                    @db.Decimal(10, 7)
  tipo                 TipoProveedor               @default(SUBARRENDO)
  estadoVerificacion   EstadoVerificacionProveedor @default(BORRADOR)
  origenCaptura        OrigenCapturaProveedor      @default(INTERNO)
  eventosSimultaneosMax Int?
  unidadesMaxEntrega   Int?
  radioCoberturaKm     Int?
  notas                String?
  activo               Boolean                     @default(true)
  createdAt            DateTime                    @default(now())
  updatedAt            DateTime                    @updatedAt

  items       CotizacionItem[]
  subarrendos Subarrendo[]
  productos   ProductoProveedor[]
  coberturas  CoberturaProveedor[]
  servicios   ServicioProveedor[]
  menusBanquete MenuBanqueteProveedor[]
  usuarios    Usuario[]
  clientesPortal ClienteProveedor[]
  ordenesCobro   OrdenCobro[]
  eventosClientes EventoClienteProveedor[]
  seguimientos    SeguimientoCliente[]
  configPasarela  ConfigPasarelaProveedor?
  perfilEmpresa   PerfilEmpresaProveedor?
  cotizaciones    CotizacionProveedor[]
  plantillasContrato PlantillaContratoProveedor[]
  contratosEmitidos ContratoEmitidoProveedor[]
  suscripcion     Suscripcion?

  @@index([tipo])
  @@index([activo])
  @@index([entidadFederativa])
  @@index([ciudad])
  @@index([alcaldia])
  @@index([estadoVerificacion])
}

model ProductoProveedor {
  id                 String               @id @default(cuid())
  proveedorId        String
  nombre             String
  categoria          String?
  descripcion        String?
  cantidadDisponible Int                  @default(0)
  precioReferencia   Decimal              @default(0) @db.Decimal(12, 2)
  unidadMedida       UnidadMedidaProducto @default(PIEZA)
  activo             Boolean              @default(true)
  createdAt          DateTime             @default(now())
  updatedAt          DateTime             @updatedAt

  proveedor Proveedor               @relation(fields: [proveedorId], references: [id], onDelete: Cascade)
  fotos     FotoProductoProveedor[]
  cotizacionItems CotizacionProveedorItem[]

  @@index([proveedorId])
  @@index([categoria])
  @@index([activo])
}

model FotoProductoProveedor {
  id                  String  @id @default(cuid())
  productoProveedorId String
  url                 String
  esPrincipal         Boolean @default(false)
  orden               Int     @default(0)

  producto ProductoProveedor @relation(fields: [productoProveedorId], references: [id], onDelete: Cascade)

  @@index([productoProveedorId])
}

model CoberturaProveedor {
  id          String  @id @default(cuid())
  proveedorId String
  entidad     String
  ciudad      String?
  notas       String?

  proveedor Proveedor @relation(fields: [proveedorId], references: [id], onDelete: Cascade)

  @@index([proveedorId])
  @@index([entidad])
}

model ServicioProveedor {
  id               String   @id @default(cuid())
  proveedorId      String
  nombre           String
  descripcion      String?
  precioReferencia Decimal? @db.Decimal(12, 2)
  activo           Boolean  @default(true)
  createdAt        DateTime @default(now())
  updatedAt        DateTime @updatedAt

  proveedor       Proveedor                 @relation(fields: [proveedorId], references: [id], onDelete: Cascade)
  cotizacionItems CotizacionProveedorItem[]
  plantillasContrato PlantillaContratoProveedor[]

  @@index([proveedorId])
}

enum SeccionPlatilloMenu {
  ENTRADA
  SOPA
  PLATO_FUERTE
  GUARNICION
  POSTRE
  BEBIDA
  OTRO
}

enum ModalidadPrecioMenu {
  POR_PERSONA
  POR_EVENTO
}

model MenuBanqueteProveedor {
  id               String   @id @default(cuid())
  proveedorId      String
  nombre           String
  descripcion      String?  @db.Text
  precioPorPersona Decimal? @db.Decimal(12, 2)
  precioPorEvento  Decimal? @db.Decimal(12, 2)
  minimoPersonas   Int?
  incluyeBebidas   Boolean  @default(false)
  incluyeMeseros   Boolean  @default(false)
  notas            String?  @db.Text
  activo           Boolean  @default(true)
  createdAt        DateTime @default(now())
  updatedAt        DateTime @updatedAt

  proveedor       Proveedor                 @relation(fields: [proveedorId], references: [id], onDelete: Cascade)
  platillos       PlatilloMenuBanquete[]
  cotizacionItems CotizacionProveedorItem[]
  plantillasContrato PlantillaContratoProveedor[]

  @@index([proveedorId])
  @@index([activo])
}

model PlatilloMenuBanquete {
  id          String              @id @default(cuid())
  menuId      String
  seccion     SeccionPlatilloMenu @default(OTRO)
  nombre      String
  descripcion String?
  orden       Int                 @default(0)

  menu MenuBanqueteProveedor @relation(fields: [menuId], references: [id], onDelete: Cascade)

  @@index([menuId])
}

model Vehiculo {
  id        String   @id @default(cuid())
  nombre    String
  placa     String   @unique
  capacidad String?
  activo    Boolean  @default(true)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  logisticas Logistica[]
}

model ActividadAgenda {
  id          String        @id @default(cuid())
  eventoId    String
  tipo        TipoActividad
  titulo      String
  fechaInicio DateTime
  fechaFin    DateTime?
  lugar       String?
  completada  Boolean       @default(false)
  notas       String?
  createdAt   DateTime      @default(now())
  updatedAt   DateTime      @updatedAt

  evento Evento @relation(fields: [eventoId], references: [id], onDelete: Cascade)

  @@index([eventoId])
  @@index([fechaInicio])
}

model Logistica {
  id           String          @id @default(cuid())
  eventoId     String          @unique
  vehiculoId   String?
  conductor    String?
  equipo       String?
  fechaSalida  DateTime?
  fechaRegreso DateTime?
  ruta         String?
  estado       EstadoLogistica @default(PENDIENTE)
  notas        String?
  createdAt    DateTime        @default(now())
  updatedAt    DateTime        @updatedAt

  evento    Evento                   @relation(fields: [eventoId], references: [id], onDelete: Cascade)
  vehiculo  Vehiculo?                @relation(fields: [vehiculoId], references: [id], onDelete: SetNull)
  checklist LogisticaChecklistItem[]

  @@index([estado])
}

model LogisticaChecklistItem {
  id          String  @id @default(cuid())
  logisticaId String
  descripcion String
  completado  Boolean @default(false)
  orden       Int     @default(0)

  logistica Logistica @relation(fields: [logisticaId], references: [id], onDelete: Cascade)

  @@index([logisticaId])
}

model Subarrendo {
  id               String           @id @default(cuid())
  eventoId         String
  proveedorId      String
  cotizacionItemId String?
  descripcion      String
  cantidad         Int              @default(1)
  costo            Decimal          @default(0) @db.Decimal(12, 2)
  estado           EstadoSubarrendo @default(IDENTIFICADO)
  fechaEntrega     DateTime?
  notas            String?
  createdAt        DateTime         @default(now())
  updatedAt        DateTime         @updatedAt

  evento    Evento    @relation(fields: [eventoId], references: [id], onDelete: Cascade)
  proveedor Proveedor @relation(fields: [proveedorId], references: [id], onDelete: Restrict)

  @@index([eventoId])
  @@index([estado])
}

model Cotizacion {
  id            String           @id @default(cuid())
  folio         String           @unique
  eventoId      String
  estado        EstadoCotizacion @default(BORRADOR)
  margenGlobal  Decimal          @default(30) @db.Decimal(5, 2)
  subtotalCosto Decimal          @default(0) @db.Decimal(12, 2)
  subtotalVenta Decimal          @default(0) @db.Decimal(12, 2)
  total         Decimal          @default(0) @db.Decimal(12, 2)
  utilidad      Decimal          @default(0) @db.Decimal(12, 2)
  notas         String?
  validoHasta   DateTime?
  createdAt     DateTime         @default(now())
  updatedAt     DateTime         @updatedAt

  evento Evento           @relation(fields: [eventoId], references: [id], onDelete: Cascade)
  items  CotizacionItem[]
  documentos Documento[]

  @@index([eventoId])
  @@index([estado])
}

model CotizacionItem {
  id               String  @id @default(cuid())
  cotizacionId     String
  productoId       String?
  proveedorId      String?
  descripcion      String
  cantidad         Int     @default(1)
  costoUnitario    Decimal @db.Decimal(12, 2)
  margenPorcentaje Decimal @default(30) @db.Decimal(5, 2)
  precioUnitario   Decimal @db.Decimal(12, 2)
  subtotal         Decimal @db.Decimal(12, 2)
  esSubarrendo     Boolean @default(false)

  cotizacion Cotizacion @relation(fields: [cotizacionId], references: [id], onDelete: Cascade)
  producto   Producto?  @relation(fields: [productoId], references: [id], onDelete: SetNull)
  proveedor  Proveedor? @relation(fields: [proveedorId], references: [id], onDelete: SetNull)

  @@index([cotizacionId])
  @@index([productoId])
}

model MovimientoFinanciero {
  id         String                     @id @default(cuid())
  eventoId   String
  tipo       TipoMovimientoFinanciero
  concepto   String
  monto      Decimal                    @db.Decimal(12, 2)
  metodoPago MetodoPago                 @default(TRANSFERENCIA)
  estado     EstadoMovimientoFinanciero @default(CONFIRMADO)
  referencia String?
  fecha      DateTime                   @default(now())
  notas      String?
  createdAt  DateTime                   @default(now())
  updatedAt  DateTime                   @updatedAt

  evento Evento @relation(fields: [eventoId], references: [id], onDelete: Cascade)

  @@index([eventoId])
  @@index([tipo])
  @@index([estado])
  @@index([fecha])
}

model Documento {
  id           String        @id @default(cuid())
  eventoId     String
  cotizacionId String?
  tipo         TipoDocumento
  titulo       String
  folio        String?
  contenido    String?
  generadoEn   DateTime      @default(now())
  createdAt    DateTime      @default(now())
  updatedAt    DateTime      @updatedAt

  evento     Evento      @relation(fields: [eventoId], references: [id], onDelete: Cascade)
  cotizacion Cotizacion? @relation(fields: [cotizacionId], references: [id], onDelete: SetNull)

  @@index([eventoId])
  @@index([tipo])
  @@index([cotizacionId])
}

model ClienteProveedor {
  id          String   @id @default(cuid())
  proveedorId String
  nombre      String
  empresa     String?
  email       String?
  telefono    String?
  notas       String?
  activo      Boolean  @default(true)
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  proveedor Proveedor    @relation(fields: [proveedorId], references: [id], onDelete: Cascade)
  cobros    OrdenCobro[]
  eventos   EventoClienteProveedor[]
  seguimientos SeguimientoCliente[]
  cotizaciones CotizacionProveedor[]

  @@index([proveedorId])
  @@index([nombre])
}

model OrdenCobro {
  id                 String           @id @default(cuid())
  proveedorId        String
  clienteProveedorId String
  folio              String
  concepto           String
  monto              Decimal          @db.Decimal(12, 2)
  estado             EstadoOrdenCobro @default(PENDIENTE)
  metodoPago         MetodoPago       @default(TRANSFERENCIA)
  referencia         String?
  fechaVencimiento   DateTime?
  pagadoEn           DateTime?
  notas              String?
  tokenPago          String                 @unique @default(cuid())
  linkPago           String?
  mpPreferenceId     String?
  mpPaymentId        String?
  linkPagoGeneradoEn DateTime?
  createdAt          DateTime               @default(now())
  updatedAt          DateTime         @updatedAt

  proveedor        Proveedor        @relation(fields: [proveedorId], references: [id], onDelete: Cascade)
  clienteProveedor ClienteProveedor @relation(fields: [clienteProveedorId], references: [id], onDelete: Restrict)

  @@unique([proveedorId, folio])
  @@index([proveedorId])
  @@index([clienteProveedorId])
  @@index([estado])
  @@index([createdAt])
  @@index([tokenPago])
}

model ConfigPasarelaProveedor {
  id                     String                @id @default(cuid())
  proveedorId            String                @unique
  pasarela               PasarelaPagoProveedor @default(MERCADO_PAGO)
  mercadoPagoAccessToken String?
  mercadoPagoPublicKey   String?
  activo                 Boolean               @default(false)
  createdAt              DateTime              @default(now())
  updatedAt              DateTime              @updatedAt

  proveedor Proveedor @relation(fields: [proveedorId], references: [id], onDelete: Cascade)
}

model PerfilEmpresaProveedor {
  id                     String   @id @default(cuid())
  proveedorId            String   @unique
  logoUrl                String?
  regimenFiscal          String?
  codigoPostal           String?
  horario                Json?
  redesSociales          Json?
  politicasRenta         String?  @db.Text
  condicionesCancelacion String?  @db.Text
  ivaIncluido            Boolean  @default(false)
  moneda                 String   @default("MXN")
  createdAt              DateTime @default(now())
  updatedAt              DateTime @updatedAt

  proveedor Proveedor @relation(fields: [proveedorId], references: [id], onDelete: Cascade)
}

model CotizacionProveedor {
  id                  String           @id @default(cuid())
  proveedorId         String
  clienteProveedorId  String
  folio               String
  titulo              String?
  estado              EstadoCotizacion @default(BORRADOR)
  fechaEvento         DateTime?
  lugarEntrega        String?
  costoEnvio          Decimal          @default(0) @db.Decimal(12, 2)
  descuentoPorcentaje Decimal          @default(0) @db.Decimal(5, 2)
  descuentoMonto      Decimal          @default(0) @db.Decimal(12, 2)
  ivaPorcentaje       Decimal          @default(16) @db.Decimal(5, 2)
  ivaIncluido         Boolean          @default(false)
  subtotal            Decimal          @default(0) @db.Decimal(12, 2)
  montoIva            Decimal          @default(0) @db.Decimal(12, 2)
  total               Decimal          @default(0) @db.Decimal(12, 2)
  notas               String?          @db.Text
  validoHasta         DateTime?
  createdAt           DateTime         @default(now())
  updatedAt           DateTime         @updatedAt

  proveedor        Proveedor                 @relation(fields: [proveedorId], references: [id], onDelete: Cascade)
  clienteProveedor ClienteProveedor          @relation(fields: [clienteProveedorId], references: [id], onDelete: Restrict)
  items            CotizacionProveedorItem[]
  contratoEmitido  ContratoEmitidoProveedor?

  @@unique([proveedorId, folio])
  @@index([proveedorId])
  @@index([clienteProveedorId])
  @@index([estado])
  @@index([createdAt])
}

model CotizacionProveedorItem {
  id                      String               @id @default(cuid())
  cotizacionProveedorId   String
  productoProveedorId     String?
  menuBanqueteProveedorId String?
  servicioProveedorId     String?
  modalidadPrecioMenu     ModalidadPrecioMenu?
  descripcion             String
  cantidad                Int                  @default(1)
  precioUnitario          Decimal              @db.Decimal(12, 2)
  subtotal                Decimal              @db.Decimal(12, 2)

  cotizacion        CotizacionProveedor  @relation(fields: [cotizacionProveedorId], references: [id], onDelete: Cascade)
  productoProveedor ProductoProveedor?   @relation(fields: [productoProveedorId], references: [id], onDelete: SetNull)
  menuBanquete      MenuBanqueteProveedor? @relation(fields: [menuBanqueteProveedorId], references: [id], onDelete: SetNull)
  servicioProveedor ServicioProveedor?     @relation(fields: [servicioProveedorId], references: [id], onDelete: SetNull)

  @@index([cotizacionProveedorId])
  @@index([productoProveedorId])
  @@index([menuBanqueteProveedorId])
  @@index([servicioProveedorId])
}

model EventoClienteProveedor {
  id                 String                @id @default(cuid())
  proveedorId        String
  clienteProveedorId String
  titulo             String
  descripcion        String?
  fechaEvento        DateTime
  fechaFin           DateTime?
  fechaEntrega       DateTime?
  fechaRecogida      DateTime?
  lugar              String?
  estado             EstadoEventoProveedor @default(COTIZACION)
  montoEstimado      Decimal?              @db.Decimal(12, 2)
  notas              String?
  createdAt          DateTime              @default(now())
  updatedAt          DateTime              @updatedAt

  proveedor        Proveedor        @relation(fields: [proveedorId], references: [id], onDelete: Cascade)
  clienteProveedor ClienteProveedor @relation(fields: [clienteProveedorId], references: [id], onDelete: Cascade)

  @@index([proveedorId])
  @@index([clienteProveedorId])
  @@index([fechaEvento])
  @@index([estado])
}

model SeguimientoCliente {
  id                 String                   @id @default(cuid())
  proveedorId        String
  clienteProveedorId String
  tipo               TipoSeguimientoCliente
  titulo             String
  descripcion        String?
  fechaProgramada    DateTime
  completadoEn       DateTime?
  estado             EstadoSeguimientoCliente @default(PENDIENTE)
  createdAt          DateTime                 @default(now())
  updatedAt          DateTime                 @updatedAt

  proveedor        Proveedor        @relation(fields: [proveedorId], references: [id], onDelete: Cascade)
  clienteProveedor ClienteProveedor @relation(fields: [clienteProveedorId], references: [id], onDelete: Cascade)

  @@index([proveedorId])
  @@index([clienteProveedorId])
  @@index([fechaProgramada])
  @@index([estado])
}

model Plan {
  id            String   @id @default(cuid())
  nombre        String
  codigo        String   @unique
  precioMensual Decimal  @db.Decimal(12, 2)
  moneda        String   @default("MXN")
  descripcion   String?
  activo        Boolean  @default(true)
  createdAt     DateTime @default(now())
  updatedAt     DateTime @updatedAt

  suscripciones Suscripcion[]
}

model Suscripcion {
  id             String             @id @default(cuid())
  proveedorId    String             @unique
  planId         String
  estado         EstadoSuscripcion  @default(PRUEBA)
  fechaAlta      DateTime           @default(now())
  proximoCobro   DateTime?
  metodoPago     MetodoPago?
  referenciaPago String?
  canceladaEn    DateTime?
  createdAt      DateTime           @default(now())
  updatedAt      DateTime           @updatedAt

  proveedor Proveedor           @relation(fields: [proveedorId], references: [id], onDelete: Cascade)
  plan      Plan                @relation(fields: [planId], references: [id], onDelete: Restrict)
  pagos     PagoSuscripcion[]

  @@index([planId])
  @@index([estado])
  @@index([proximoCobro])
}

model PlantillaContratoProveedor {
  id                      String                  @id @default(cuid())
  proveedorId             String
  nombre                  String
  descripcion             String?
  tipoServicio            TipoServicioContrato    @default(GENERAL)
  servicioProveedorId     String?
  menuBanqueteProveedorId String?
  modo                    ModoPlantillaContrato   @default(EDITOR)
  estado                  EstadoPlantillaContrato @default(BORRADOR)
  secciones               Json?
  archivoNombre           String?
  archivoMime             String?
  archivoContenido        String?                 @db.Text
  createdAt               DateTime                @default(now())
  updatedAt               DateTime                @updatedAt

  proveedor Proveedor              @relation(fields: [proveedorId], references: [id], onDelete: Cascade)
  servicio  ServicioProveedor?     @relation(fields: [servicioProveedorId], references: [id], onDelete: SetNull)
  menu      MenuBanqueteProveedor? @relation(fields: [menuBanqueteProveedorId], references: [id], onDelete: SetNull)
  contratosEmitidos ContratoEmitidoProveedor[]

  @@index([proveedorId])
  @@index([tipoServicio])
  @@index([estado])
}

model ContratoEmitidoProveedor {
  id                    String    @id @default(cuid())
  proveedorId           String
  plantillaContratoId   String
  cotizacionProveedorId String?   @unique
  folio                 String
  clienteNombre         String
  clienteEmpresa        String?
  clienteEmail          String?
  clienteTelefono       String?
  fechaEvento           DateTime?
  lugarEvento           String?
  montoTotal            Decimal?  @db.Decimal(12, 2)
  servicioNombre        String?
  enviadoEn             DateTime?
  enviadoA              String?
  asuntoEnvio           String?
  mensajeEnvio          String?   @db.Text
  createdAt             DateTime  @default(now())
  updatedAt             DateTime  @updatedAt

  proveedor  Proveedor                  @relation(fields: [proveedorId], references: [id], onDelete: Cascade)
  plantilla  PlantillaContratoProveedor @relation(fields: [plantillaContratoId], references: [id], onDelete: Restrict)
  cotizacion CotizacionProveedor?       @relation(fields: [cotizacionProveedorId], references: [id], onDelete: SetNull)

  @@unique([proveedorId, folio])
  @@index([proveedorId])
  @@index([plantillaContratoId])
  @@index([createdAt])
}

model PagoSuscripcion {
  id            String                @id @default(cuid())
  suscripcionId String
  monto         Decimal               @db.Decimal(12, 2)
  moneda        String                @default("MXN")
  estado        EstadoPagoSuscripcion @default(PAGADO)
  metodoPago    MetodoPago
  referencia    String?
  periodoInicio DateTime
  periodoFin    DateTime
  pagadoEn      DateTime              @default(now())
  createdAt     DateTime              @default(now())

  suscripcion Suscripcion @relation(fields: [suscripcionId], references: [id], onDelete: Cascade)

  @@index([suscripcionId])
  @@index([pagadoEn])
}
