# Copiar estas variables al servicio API en Railway (Settings → Variables)
# Reemplaza las URLs example.railway.app por las que te asigne Railway tras Generate Domain

DATABASE_URL=${{Postgres.DATABASE_URL}}

JWT_SECRET=EventOS-RemoRent-Prod-8Kx2mP9vL4nQ7wR3jH6fD1sA5bC0eU2tY
JWT_EXPIRES_IN=7d

# Railway inyecta PORT automáticamente — no hace falta API_PORT
# Si quieres forzarlo en local, usa API_PORT=3001

# URL pública del CRM (servicio web en Railway)
CORS_ORIGIN=https://eventos-web-production.up.railway.app
WEB_PUBLIC_URL=https://eventos-web-production.up.railway.app

# URL pública de ESTA API (Generate Domain en el servicio api)
API_PUBLIC_URL=https://eventos-api-production.up.railway.app

# Mercado Pago (opcional — dejar vacío hasta configurar pasarela)
MERCADOPAGO_ACCESS_TOKEN=
MERCADOPAGO_PUBLIC_KEY=

# Correo (opcional — sin SMTP el envío se simula en logs)
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASS=
SMTP_FROM=

NODE_ENV=production
